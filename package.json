{
  "name": "personal-finances",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "worker": "tsx --env-file-if-exists=.env src/worker/index.ts",
    "worker:dev": "tsx watch --env-file-if-exists=.env src/worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/server/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test:unit",
    "check:full": "pnpm check && pnpm build",
    "harness:check": "tsx scripts/validate-feature-list.ts",
    "harness:feature": "tsx scripts/harness-feature.ts",
    "harness:verify": "tsx scripts/verify-feature.ts",
    "harness:clean-state": "bash scripts/clean-state-check.sh",
    "harness:loop": "tsx scripts/harness-loop.ts",
    "harness:report": "tsx scripts/harness-loop.ts --report",
    "prepare": "husky"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "node-cron": "^4.6.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.15.0",
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
