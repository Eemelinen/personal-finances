# Copy to .env and fill in. .env is read by Next.js, the worker scripts,
# drizzle-kit and Docker Compose.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=finances
# Use a URL-safe password (letters, digits, - and _), it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finances
POSTGRES_PORT=5434
# Used when running the app/worker on the host (npm run dev). Docker Compose
# builds its own URL pointing at the `db` service.
DATABASE_URL=postgres://finances:change-me@localhost:5434/finances

# --- App ----------------------------------------------------------------------
APP_PORT=3000
APP_TIMEZONE=Europe/Helsinki

# --- Added by later tickets ---------------------------------------------------
# FIN-004 single-user auth
# AUTH_PASSWORD_HASH=
# SESSION_SECRET=
# FIN-006 Enable Banking (private key file lives in ./secrets, never committed)
# ENABLE_BANKING_APP_ID=
# ENABLE_BANKING_PRIVATE_KEY_PATH=./secrets/enable-banking.pem
# ENABLE_BANKING_REDIRECT_URL=http://localhost:3000/connections/callback
# FIN-007 encryption of stored tokens/session ids at rest
# ENCRYPTION_KEY=
