# Copy to .env and fill in. .env is read by Next.js, the worker scripts,
# drizzle-kit and Docker Compose.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=finances
# Use a URL-safe password (letters, digits, - and _), it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finances
POSTGRES_PORT=5434
# Used when running the app/worker on the host (pnpm dev). Docker Compose
# builds its own URL pointing at the `db` service.
DATABASE_URL=postgres://finances:change-me@localhost:5434/finances

# --- App ----------------------------------------------------------------------
APP_PORT=3000
APP_TIMEZONE=Europe/Helsinki
# When the worker syncs the bank connections (FIN-010), a cron expression in
# APP_TIMEZONE. The default, every 6 hours, is the four unattended fetches a
# day PSD2 allows per consent; keep to at most four.
# SYNC_CRON=0 */6 * * *

# --- Login (FIN-004) ----------------------------------------------------------
# Only the web app reads these. `pnpm auth:hash` asks for the password and
# prints the line to paste here (an argon2id hash, base64url-encoded because the
# Next.js .env loader would expand the `$` signs of the raw hash).
AUTH_PASSWORD_HASH=
# At least 32 random characters, e.g. `openssl rand -base64 32`. Changing it
# signs every browser out.
SESSION_SECRET=

# --- Bank providers (FIN-005) ------------------------------------------------
# Encrypts provider session ids stored in the database (AES-256-GCM): 32 random
# bytes, base64, e.g. `openssl rand -base64 32`. Losing or changing it makes
# the stored bank connections unreadable (reconnect them).
ENCRYPTION_KEY=
# Which provider new bank connections use: `enable_banking` (default) or
# `fake`, the deterministic in-memory bank for tests and e2e only.
# BANK_PROVIDER=enable_banking

# --- Investments (FIN-020) ---------------------------------------------------
# Twelve Data API key (free Basic plan: 8 requests a minute, 800 a day) for the
# worker's daily closing prices. Without it only the ECB exchange rates are
# fetched and holdings are valued at their last imported trade price.
# PRICE_API_KEY=

# --- Crypto (FIN-021) ---------------------------------------------------------
# A read-only Kraken key for the worker's Kraken sync (every 6 hours): Query
# Funds, Query Open/Closed Orders & Trades and Query Ledger Entries only, never
# trading, deposits or withdrawals. Both or neither; the worker stores them
# encrypted with ENCRYPTION_KEY (which it then needs too).
# KRAKEN_API_KEY=
# KRAKEN_API_SECRET=
# Optional CoinGecko demo key for crypto prices; the public API works without
# one at a lower rate limit.
# COINGECKO_API_KEY=

# --- Enable Banking (FIN-006) -------------------------------------------------
# The application registered at enablebanking.com: its id (the JWT's `kid`)
# and its RSA private key, a PEM file in ./secrets (gitignored, never
# committed; Docker Compose mounts ./secrets read-only at /app/secrets, so keep
# the path relative). The redirect URL must match the one registered for the
# application. ENABLE_BANKING_ENV is the environment the application was
# registered in (`sandbox` or `production`); both use the same API.
# Unset, the app starts but bank connections fail on first use.
# ENABLE_BANKING_APP_ID=
# ENABLE_BANKING_PRIVATE_KEY_PATH=./secrets/enable-banking.pem
# ENABLE_BANKING_REDIRECT_URL=http://localhost:3000/connections/callback
# ENABLE_BANKING_ENV=sandbox
