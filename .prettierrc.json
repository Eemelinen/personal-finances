{
  "plugins": ["prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": [
        "scripts/**",
        "tests/unit/harness/**",
        ".lintstagedrc.mjs",
        "commitlint.config.mjs",
        "docs/harness/prompts/evaluator-schema.json"
      ],
      "options": {
        "singleQuote": true,
        "semi": false,
        "trailingComma": "all",
        "printWidth": 100
