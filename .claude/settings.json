{
  "permissions": {
    "allow": [
      "Bash(pnpm check*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm format*)",
      "Bash(pnpm test:unit*)",
      "Bash(pnpm test:integration*)",
      "Bash(pnpm test:e2e*)",
      "Bash(pnpm harness:check)",
      "Bash(pnpm exec tsc*)",
      "Bash(pnpm exec prettier*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(docker ps*)",
      "Bash(docker info*)",
      "Bash(pnpm harness:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)",
      "Edit(next-env.d.ts)",
      "Write(next-env.d.ts)",
      "Edit(pnpm-lock.yaml)",
      "Write(pnpm-lock.yaml)",
      "Bash(docker compose down -v*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)"
    ]
  },
  "extraKnownMarketplaces": {
    "eemelinen-harness": {
      "source": {
        "source": "github",
        "repo": "Eemelinen/harness",
        "ref": "v0.3.0"
      }
    }
  },
  "enabledPlugins": {
    "harness@eemelinen-harness": true
  }
}
